# Frontend (Vite) environment variables.
# Copy this file to `.env` and fill in real values. Vite only exposes vars
# prefixed with VITE_. Values here are placeholders, NOT real credentials.

# --- Microsoft Entra ID (MSAL) — required for sign-in ---
# Application (client) ID from your Azure AD app registration.
VITE_MSAL_CLIENT_ID=your-azure-app-client-id
# Authority URL. Multi-tenant default:
VITE_MSAL_AUTHORITY=https://login.microsoftonline.com/common
# Redirect URI. Optional: the app falls back to window.location.origin in the
# browser, so this is mainly for documentation / non-browser contexts.
VITE_MSAL_REDIRECT_URI=http://localhost:5174

# --- Supabase — required for all data access ---
# Without these the app boots against a placeholder and every query fails
# silently (empty results under RLS). Get them from the Supabase dashboard:
# Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Workflow server — required for transcription/summarization ---
# Base URL of the workflow-server backend (see workflow-server/.env.example).
VITE_WORKFLOW_API_URL=http://localhost:8787

# --- Optional debugging ---
# Set to "true" to log Supabase auth token provider lifecycle to the console.
VITE_DEBUG_SUPABASE_AUTH=false
