# Workflow server (Node) environment variables.
# Copy this file to `.env` and fill in real values. These are placeholders,
# NOT real credentials. See workflow-server/README.md for full descriptions.
#
# SOURCE OF TRUTH: prod values live in the Render service's Environment tab; local
# dev values live in this `.env`. Do NOT commit `.env` (it is gitignored).
# WARNING: a placeholder left in `.env` (e.g. SUPABASE_URL below) does NOT error at
# startup — it fails later mid-request with a confusing `getaddrinfo ENOTFOUND
# your-project-ref.supabase.co`. Run `npm run env:check` after editing to catch that.

# --- Supabase (service role) — required ---
# Server-side access with the service role key. Get from Supabase dashboard:
# Project Settings > API. Keep the service role key secret; never expose it to
# the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Transcription (AssemblyAI) — required ---
ASSEMBLYAI_API_KEY=your-assemblyai-api-key
# Optional. Defaults to universal-3-pro.
ASSEMBLYAI_SPEECH_MODEL=
# Optional cost tracking. Defaults to 0.21.
ASSEMBLYAI_TRANSCRIPTION_PRICE_PER_HOUR_USD=

# --- Summarization (Gemini) — required ---
GEMINI_API_KEY=your-gemini-api-key
# Optional model overrides.
GEMINI_SUMMARY_MODEL=
GEMINI_REGENERATE_SUMMARY_MODEL=
GEMINI_TRANSCRIPTION_TEST_MODEL=
# Optional Gemini price overrides (per 1M tokens).
GEMINI_INPUT_PRICE_PER_1M_TOKENS=
GEMINI_TEXT_INPUT_PRICE_PER_1M_TOKENS=
GEMINI_AUDIO_INPUT_PRICE_PER_1M_TOKENS=
GEMINI_OUTPUT_PRICE_PER_1M_TOKENS=

# --- Optional transcription-model-test providers ---
# Only needed if you use the Transcription Model Test admin page.
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_TEST_MODEL=

# --- CORS / server ---
# Optional. Restrict to your frontend origin instead of the "*" default.
APP_FRONTEND_ORIGIN=http://localhost:5174
# Optional. Defaults to 8787.
PORT=8787
# Optional. Set to "production" in deploy.
NODE_ENV=development

# --- Long-request timeouts ---
# Optional. Both default to 1200000 (20 minutes).
WORKFLOW_FETCH_HEADERS_TIMEOUT_MS=
WORKFLOW_FETCH_BODY_TIMEOUT_MS=

# --- Error alert emails (Resend) — optional ---
# Enables failure-alert emails. Either RESEND_API_KEY or
# WORKFLOW_ALERT_RESEND_API_KEY works.
RESEND_API_KEY=
WORKFLOW_ALERT_RESEND_API_KEY=
# Optional. Set to "false" to disable alert emails.
WORKFLOW_ALERTS_ENABLED=
WORKFLOW_ALERT_TO=
WORKFLOW_ALERT_FROM=
WORKFLOW_ALERT_APP_NAME=
