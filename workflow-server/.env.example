# Workflow server (Node) environment variables.
# Copy this file to `.env` and fill in real values. These are placeholders,
# NOT real credentials. See workflow-server/README.md for full descriptions.
#
# SOURCE OF TRUTH: prod values live in the Render service's Environment tab; local
# dev values live in this `.env`. Do NOT commit `.env` (it is gitignored).
# WARNING: a placeholder left in `.env` (e.g. SUPABASE_URL below) does NOT error at
# startup — it fails later mid-request with a confusing `getaddrinfo ENOTFOUND
# your-project-ref.supabase.co`. Run `npm run env:check` after editing to catch that.

# --- Supabase (service role) — required ---
# Server-side access with the service role key. Get from Supabase dashboard:
# Project Settings > API. Keep the service role key secret; never expose it to
# the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Transcription (AssemblyAI) — required ---
ASSEMBLYAI_API_KEY=your-assemblyai-api-key
# Optional. Defaults to universal-3-pro.
ASSEMBLYAI_SPEECH_MODEL=
# Optional cost tracking. Defaults to 0.21.
ASSEMBLYAI_TRANSCRIPTION_PRICE_PER_HOUR_USD=

# --- Summarization (Gemini) — required ---
GEMINI_API_KEY=your-gemini-api-key
# Optional model overrides.
GEMINI_SUMMARY_MODEL=
GEMINI_REGENERATE_SUMMARY_MODEL=
GEMINI_TRANSCRIPTION_TEST_MODEL=
# Optional Gemini price overrides (per 1M tokens).
GEMINI_INPUT_PRICE_PER_1M_TOKENS=
GEMINI_TEXT_INPUT_PRICE_PER_1M_TOKENS=
GEMINI_AUDIO_INPUT_PRICE_PER_1M_TOKENS=
GEMINI_OUTPUT_PRICE_PER_1M_TOKENS=

# --- Optional transcription-model-test providers ---
# Only needed if you use the Transcription Model Test admin page.
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_TEST_MODEL=

# --- CORS / server ---
# Optional. Restrict to your frontend origin instead of the "*" default.
APP_FRONTEND_ORIGIN=http://localhost:5174
# Optional. Defaults to 8787.
PORT=8787
# Optional. Set to "production" in deploy.
NODE_ENV=development

# --- Long-request timeouts ---
# Optional. Both default to 1200000 (20 minutes).
WORKFLOW_FETCH_HEADERS_TIMEOUT_MS=
WORKFLOW_FETCH_BODY_TIMEOUT_MS=

# --- Error alert emails (Resend) — optional ---
# Enables failure-alert emails. Either RESEND_API_KEY or
# WORKFLOW_ALERT_RESEND_API_KEY works.
RESEND_API_KEY=
WORKFLOW_ALERT_RESEND_API_KEY=
# Optional. Set to "false" to disable alert emails.
WORKFLOW_ALERTS_ENABLED=
WORKFLOW_ALERT_TO=
WORKFLOW_ALERT_FROM=
WORKFLOW_ALERT_APP_NAME=

# --- Meeting knowledge access — disabled until isolated SSO/DB validation ---
# Dedicated random server Bearer key; share only with AXKH, never with browsers.
MEETING_KNOWLEDGE_ACCESS_ENABLED=
MEETING_KNOWLEDGE_ACCESS_KEY=
MEETING_KNOWLEDGE_TENANT_ID=
# Owner-management accepts only the upgraded signed Supabase JWT.
MEETING_KNOWLEDGE_MANAGEMENT_ENABLED=
SUPABASE_JWT_SECRET=
# Comma-separated Microsoft tenant ids (TecAce). ALSO the org gate for every route that takes a
# Microsoft Graph token (summaries, issues, product docs, MCP Graph fallback, MCP /admin).
# Empty = any tenant is accepted (warned at runtime; product docs refused). See /health msTenantGate.
ALLOWED_MS_TENANT_IDS=
# Confused-deputy check on the Graph token's appid/azp. Known clients = MS_KNOWN_CLIENT_IDS +
# MS_ID_TOKEN_CLIENT_IDS + MSAL_CLIENT_ID + VITE_MSAL_CLIENT_ID + MCP_OAUTH_CLIENT_ID +
# MCP_ADMIN_CLIENT_ID. Unknown clients are only logged (ms_token_client_check) until
# MS_TOKEN_REQUIRE_KNOWN_CLIENT=true. See /health msClientGate.
MS_KNOWN_CLIENT_IDS=
MS_TOKEN_REQUIRE_KNOWN_CLIENT=

# --- Meeting knowledge delivery — opt-in after isolated SSO/DB validation ---
# Separate random server key from MEETING_KNOWLEDGE_ACCESS_KEY (>=32 bytes).
# Sends only verified/enrolled source snapshots to AXKH's private event store.
MEETING_KNOWLEDGE_DELIVERY_ENABLED=
MEETING_KNOWLEDGE_AXKH_URL=
MEETING_KNOWLEDGE_INGEST_KEY=
MEETING_KNOWLEDGE_NOTE_BASE_URL=
MEETING_KNOWLEDGE_TIMEZONE=

# --- Structured meeting candidates — disabled until policy/SSO/DB validation ---
# Requires delivery above. Reuses the server's GEMINI_API_KEY; no model fallback.
# AXKH must explicitly approve the source classification and Google's global /
# provider-default processing terms. Read permission alone does not approve it.
MEETING_KNOWLEDGE_EXTRACTION_ENABLED=
MEETING_KNOWLEDGE_EXTRACTION_MODEL=
# Optional chunk budget, defaults to 16. Skipped text stays in coverage/raw source.
MEETING_KNOWLEDGE_EXTRACTION_MAX_CHUNKS=
# Third dedicated random key, distinct from ingest and access keys (>=32 bytes).
MEETING_KNOWLEDGE_MODEL_POLICY_KEY=
