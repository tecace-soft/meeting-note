  "definitions": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenantId": {
          "$ref": "#/definitions/uuid"
        },
        "objectId": {
          "$ref": "#/definitions/uuid"
        }
      },
      "required": [
        "tenantId",
        "objectId"
      ]
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spanId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "textHash": {
          "$ref": "#/definitions/hash"
        }
      },
      "required": [
        "spanId",
        "start",
        "end",
        "textHash"
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authority": {
          "const": "meeting-note-server"
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "authority",
        "evidenceRef"
      ]
    },
    "sourcePayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contentRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "speakerRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sourceHash": {
          "$ref": "#/definitions/hash"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sourceUrl": {
          "type": "string",
          "maxLength": 2048,
          "format": "uri",
          "pattern": "^https://"
        },
        "meetingAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "plaintext": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000000
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/span"
          },
          "minItems": 0,
          "maxItems": 10000
        }
      },
      "required": [
        "contentRevision",
        "speakerRevision",
        "sourceHash",
        "title",
        "sourceUrl",
        "meetingAt",
        "timezone",
        "plaintext",
        "spans"
      ]
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/definitions/identity"
        },
        "kind": {
          "type": "string",
          "enum": [
            "participant",
            "direct-share",
            "project-share"
          ]
        },
        "verification": {
          "$ref": "#/definitions/verification"
        }
      },
      "required": [
        "identity",
        "kind",
        "verification"
      ]
    },
    "accessPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accessRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/grant"
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "denies": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/identity"
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "classificationPolicyRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "accessRevision",
        "grants",
        "denies"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spanId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "textHash": {
          "$ref": "#/definitions/hash"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "contentRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sourceHash": {
          "$ref": "#/definitions/hash"
        }
      },
      "required": [
        "spanId",
        "start",
        "end",
        "textHash",
        "sourceId",
        "contentRevision",
        "sourceHash"
      ]
    },
    "extractorRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runId": {
          "$ref": "#/definitions/uuid"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "promptVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "runId",
        "model",
        "promptVersion"
      ]
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unitId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "factType": {
          "type": "string",
          "enum": [
            "definition",
            "condition",
            "status",
            "proposal",
            "decision",
            "task",
            "outcome",
            "open-question",
            "unclassified"
          ]
        },
        "speechAct": {
          "type": "string",
          "enum": [
            "statement",
            "proposal",
            "request",
            "acceptance",
            "decision",
            "correction",
            "question",
            "unclassified"
          ]
        },
        "epistemic": {
          "type": "string",
          "enum": [
            "reported",
            "verified",
            "hypothesis",
            "uncertain",
            "unclassified"
          ]
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "candidate",
            "confirmed",
            "superseded",
            "withdrawn",
            "unclassified"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/evidence"
          },
          "minItems": 1,
          "maxItems": 1000
        }
      },
      "required": [
        "unitId",
        "text",
        "evidence"
      ]
    },
    "unitsPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contentRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "speakerRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sourceHash": {
          "$ref": "#/definitions/hash"
        },
        "extractorRun": {
          "$ref": "#/definitions/extractorRun"
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/unit"
          },
          "minItems": 0,
          "maxItems": 5000
        }
      },
      "required": [
        "contentRevision",
        "speakerRevision",
        "sourceHash",
        "extractorRun",
        "units"
      ]
    },
    "deletePayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lifecycleRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reason": {
          "type": "string",
          "enum": [
            "source-deleted",
            "retention-expired"
          ]
        }
      },
      "required": [
        "lifecycleRevision",
        "reason"
      ]
    },
    "disablePayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lifecycleRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reason": {
          "type": "string",
          "enum": [
            "user-disabled",
            "policy-disabled"
          ]
        }
      },
      "required": [
        "lifecycleRevision",
        "reason"
      ]
    }
  }
}
