          "const": 1
        },
        "eventId": {
          "$ref": "#/definitions/uuid"
        },
        "eventSeq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "integrationGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sourceApp": {
          "const": "meeting-note"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "tenantId": {
          "$ref": "#/definitions/uuid"
        },
        "payloadHash": {
          "$ref": "#/definitions/hash"
        },
        "eventType": {
          "const": "source.upsert"
        },
        "payload": {
          "$ref": "#/definitions/sourcePayload"
        }
      },
      "required": [
        "schemaVersion",
        "eventId",
        "eventSeq",
        "integrationGeneration",
        "sourceApp",
