{
  "name": "@meeting-note/workflow-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test src/**/*.test.ts",
    "eval": "tsx eval/run.ts",
    "eval:gate": "tsx eval/gate.ts",
    "eval:stability": "tsx eval/stability.ts",
    "eval:inspect": "tsx eval/inspect.ts",
    "eval:speaker-ab": "tsx eval/speaker-memory-ab.ts",
    "eval:speaker-backtest": "tsx eval/speaker-backtest.ts",
    "eval:speaker-signature": "tsx eval/speaker-signature-probe.ts",
    "eval:speaker-embed": "tsx eval/speaker-embedding-probe.ts",
    "eval:roster-coverage": "tsx eval/roster-coverage.ts",
    "eval:speaker-diagnose": "tsx eval/speaker-diagnose.ts",
    "eval:self-precision": "tsx eval/self-autoapply-precision.ts",
    "eval:summary-mem": "tsx eval/summary-memory-check.ts",
    "memory:gc": "tsx scripts/consolidate-memory-gc.ts",
    "speaker:feedback": "tsx scripts/speaker-feedback-report.ts",
    "typecheck:eval": "tsc -p eval/tsconfig.json",
    "env:check": "node scripts/check-env.mjs"
  },
  "dependencies": {
    "@azure/msal-browser": "^3.28.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.106.0",
    "@types/busboy": "^1.5.4",
    "busboy": "^1.6.0",
    "dotenv": "^17.4.2",
    "jose": "^6.2.3",
    "undici": "^7.26.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "tsx": "^4.22.2",
    "typescript": "^5.9.3"
  }
}
